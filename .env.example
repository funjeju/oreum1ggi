# Firebase Console > Project settings > Web app configuration (public SDK fields).
# The supplied allquiz-f1e30 Web SDK config is the default. To use a different
# project, provide its four required public fields together and rebuild.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional Web SDK fields. The app does not initialize Analytics.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Enable Google in Authentication > Sign-in method. Add the exact fixed preview
# and production hosts under Authentication > Settings > Authorized domains.
# Popup sign-in is the default. For redirect fallback on mobile, set authDomain
# to this deployment's own hostname, add https://<host>/__/auth/handler to the
# Google OAuth client's authorized redirect URIs, enable this flag, and rebuild.
NEXT_PUBLIC_FIREBASE_AUTH_REDIRECT=false

# Merge both oreumTravelUsers matches from firestore.rules into the default
# Firestore database's existing rules. Check for existing broad rules granting
# access to this collection. Preserve rules supporting other applications.
# Server-only values for visit check-in. Use the same project ID as the Web SDK.
# A workload with Application Default Credentials can omit email and private key.
# For a Vercel service account, put these secrets only in server environment settings.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Server-only VisitJeju API key for the manual catalogue refresh command.
# node scripts/refresh-visitjeju.mjs
VISITJEJU_API_KEY=
